# =============================================================================
# TenantFlow Analytics Service — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in all values before starting the service.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
ANALYTICS_PORT=3002
LOG_LEVEL=info

# ── MongoDB ───────────────────────────────────────────────────────────────────
# MongoDB connection string for Analytics Service (separate from Monolith)
MONGO_URI=mongodb://localhost:27017/tenantflow_analytics

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection URL for BullMQ. Must point to the shared Redis instance.
REDIS_URL=redis://localhost:6379

# ── AI Configuration ──────────────────────────────────────────────────────────
# Which AI provider to use: 'openai' or 'gemini'
AI_PROVIDER=gemini

# Provider API Keys
OPENAI_API_KEY=sk-REPLACE_ME
GEMINI_API_KEY=AIzaSy_REPLACE_ME
