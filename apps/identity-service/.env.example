NODE_ENV=development
IDENTITY_PORT=3003
LOG_LEVEL=info

# MongoDB connection string for Platform Service
MONGO_URI=mongodb://localhost:27017/tenantflow_identity

# Redis connection URL for BullMQ. Must point to the shared Redis instance
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
INTERNAL_SERVICE_SECRET=REPLACE_ME
BILLING_SERVICE_URL=http://localhost:5000

