# TenantFlow Server — Environment Variables
# Copy this file to .env and fill in your values.
# REF: docs/SRS.md §18 — Environment Variables Reference

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb://mongodb:27017/tenantflow
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_replace_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_replace_in_production

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

AI_PROVIDER=openai
OPENAI_API_KEY=sk-your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM=TenantFlow <noreply@tenantflow.io>

SUPER_ADMIN_EMAIL=admin@tenantflow.io
SUPER_ADMIN_PASSWORD=SuperAdmin@123

TAX_RATE=18
DEFAULT_TRIAL_DAYS=14

LOG_LEVEL=info

BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=bullboard_admin_password
