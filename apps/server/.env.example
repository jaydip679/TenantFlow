
# ── Server ────────────────────────────────────────────────────────────────────

# Runtime environment. One of: development | staging | production
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# Full URL of the React frontend (used for CORS + email links). No trailing slash.
CLIENT_URL=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────

# Full MongoDB connection string.
# Docker Compose (local):  mongodb://mongodb:27017/tenantflow
# MongoDB Atlas (prod):    mongodb+srv://user:pass@cluster.mongodb.net/tenantflow
MONGODB_URI=mongodb://localhost:27017/tenantflow

# ── External Services ─────────────────────────────────────────────────────────

# Platform Service URL (for reverse proxying)
PLATFORM_SERVICE_URL=http://localhost:3001

# Analytics Service URL (for reverse proxying)
ANALYTICS_SERVICE_URL=http://localhost:3002

# ── Redis ─────────────────────────────────────────────────────────────────────

# Full Redis connection URL.
# Docker Compose (local):  redis://redis:6379
# Redis Cloud / Upstash:   redis://:password@hostname:port
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ────────────────────────────────────────────────────────

# Secret for signing access tokens (15-minute TTL).
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_MIN_32_CHAR_SECRET_ACCESS

# Secret for signing refresh tokens (7-day TTL).
# Must be at least 32 characters. Use a DIFFERENT value from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=REPLACE_WITH_MIN_32_CHAR_SECRET_REFRESH

# ── Razorpay ──────────────────────────────────────────────────────────────────

# Get these from https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_...) for development, live keys for production.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# Webhook secret — set in Razorpay Dashboard > Webhooks > Secret
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ── Cloudinary (Avatar Uploads) ───────────────────────────────────────────────

# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# ── SMTP (Transactional Email) ────────────────────────────────────────────────

# For local development, use Mailhog (included in docker-compose.yml):
#   SMTP_HOST=mailhog  SMTP_PORT=1025  SMTP_USER=  SMTP_PASS=
#
# For production, use SendGrid / Mailgun / SES / Postmark.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# The "from" address shown on all outgoing emails.
EMAIL_FROM=noreply@tenantflow.app

# ── Application Config ────────────────────────────────────────────────────────

# GST rate applied to invoices (percentage integer, default 18)
TAX_RATE=18

# Number of trial days granted to new tenants (default 14)
DEFAULT_TRIAL_DAYS=14

# Log level. One of: error | warn | info | http | debug
LOG_LEVEL=info

# ── Super Admin Seed ──────────────────────────────────────────────────────────

# These credentials are used to seed the super admin account on first startup.
# Change the password immediately after first login in production.
SUPER_ADMIN_EMAIL=admin@tenantflow.app
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Bull Board (Queue Monitor UI) ─────────────────────────────────────────────

# HTTP Basic Auth credentials for the Bull Board UI at GET /admin/queues
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

IDENTITY_SERVICE_URL=http://localhost:3003
INTERNAL_SERVICE_SECRET=REPLACE_ME

