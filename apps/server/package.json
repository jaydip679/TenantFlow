{
  "name": "tenantflow-server",
  "version": "1.0.0",
  "description": "TenantFlow — Multi-Tenant SaaS Billing Engine (Backend)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --runInBand --forceExit --setupFiles dotenv/config --testPathIgnorePatterns=\"\\.e2e\\.test\\.js$\"",
    "test:e2e": "jest --runInBand --forceExit --setupFiles dotenv/config --testMatch=\"**/*.e2e.test.js\"",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "lint": "eslint src/ --ext .js"
  },
  "dependencies": {
    "@bull-board/express": "^5.22.0",
    "@bull-board/ui": "^5.22.0",
    "@google/generative-ai": "^0.21.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^4.18.2",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "openai": "^4.77.0",
    "pdfkit": "^0.14.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
