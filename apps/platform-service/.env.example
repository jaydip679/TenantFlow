# ── Server configuration ────────────────────────────────────────────────────────
# Port for the Platform Service (default: 3001)
PLATFORM_PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB connection string for Platform Service
MONGO_URI=mongodb://localhost:27017/tenantflow_platform

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection URL for BullMQ. Must point to the shared Redis instance.
# Example: redis://localhost:6379 or redis://user:pass@host:port
REDIS_URL=redis://localhost:6379

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# SMTP server configuration for Nodemailer
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME

# Sender email address used for outbound emails
EMAIL_FROM="TenantFlow <noreply@tenantflow.com>"

# ── Frontend Configuration ────────────────────────────────────────────────────
# The base URL of the client application (used in email links)
CLIENT_URL=http://localhost:3000
